<Window x:Class="ACEvo_Simple_Telemetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ACEvo_Simple_Telemetry"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AC EVO Simple Telemetry" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize" SizeToContent="Manual"
        Width="980" Height="286" MinWidth="560" MinHeight="180"
        ShowInTaskbar="False" Topmost="True" SizeChanged="Window_SizeChanged" ShowActivated="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F4F4"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#85858C"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#77777E"/>
        <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#EC0A0A0C"/>
        <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#18181C"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="GaugeTrackBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#34343A"/>
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#29292E"/>
        <SolidColorBrush x:Key="GraphBackgroundBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="GraphGridBrush" Color="#465A5A60"/>
        <SolidColorBrush x:Key="WheelBackgroundBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="WheelRimBrush" Color="#E1E1E4"/>
        <SolidColorBrush x:Key="WheelSpokeBrush" Color="#B6B6BC"/>
        <SolidColorBrush x:Key="WheelHubBrush" Color="#2D2D32"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>
        <Style x:Key="ControlBarButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ControlBarStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="8,8,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="PositionLockButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Lock dragging and edge resizing"/>
            <Setter Property="AutomationProperties.Name" Value="Lock dragging and edge resizing"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="LockBackground" Background="Transparent" CornerRadius="4" Padding="7,3">
                            <Grid Width="18" Height="20">
                                <Path x:Name="Shackle" Data="M5,9 L5,5 C5,0 13,0 13,4.5"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
                                <Rectangle x:Name="LockBody" Margin="2,8,2,2" RadiusX="1" RadiusY="1"
                                           Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
                                <Ellipse Width="2" Height="2" Margin="0,5,0,0"
                                         Fill="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shackle" Property="Data" Value="M5,9 L5,5 C5,0 13,0 13,5 L13,9"/>
                                <Setter TargetName="Shackle" Property="StrokeThickness" Value="2.5"/>
                                <Setter TargetName="LockBody" Property="StrokeThickness" Value="2.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LockBackground" Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}"/>
                                <Setter TargetName="Shackle" Property="Data" Value="M5,9 L5,5 C5,0 13,0 13,5 L13,9"/>
                                <Setter TargetName="Shackle" Property="StrokeThickness" Value="3"/>
                                <Setter TargetName="LockBody" Property="StrokeThickness" Value="3"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Shackle" Property="Data" Value="M5,9 L5,5 C5,0 13,0 13,4.5"/>
                                <Setter TargetName="Shackle" Property="StrokeThickness" Value="1.6"/>
                                <Setter TargetName="LockBody" Property="StrokeThickness" Value="1.6"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ToolTip" Value="Unlock dragging and edge resizing"/>
                    <Setter Property="AutomationProperties.Name" Value="Unlock dragging and edge resizing"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="ScaledRoot" Width="980" Height="286"
            Background="{DynamicResource OverlayBackgroundBrush}" BorderThickness="0"
            CornerRadius="10" Padding="10" SnapsToDevicePixels="True" SizeChanged="ScaledRoot_SizeChanged"
            MouseEnter="ScaledRoot_HoverChanged" MouseLeave="ScaledRoot_HoverChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="StatusArea" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"/>

            <Grid x:Name="TelemetryArea" Grid.Row="0" Background="Transparent" Visibility="Collapsed"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="3" Margin="8,0,0,0" Background="Transparent"
                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="5"
                        Padding="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:SteeringWheelControl x:Name="SteeringWheel" Width="112" Height="112"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,5">
                            <TextBlock x:Name="WheelAngleText" Text="0°" FontSize="21" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="0" Margin="0,0,8,0" Background="Transparent"
                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="5">
                    <local:PedalGraphControl x:Name="PedalGraph"/>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ClutchGauge" Grid.Column="0" Width="36">
                        <ProgressBar x:Name="ClutchBar" Orientation="Vertical" Minimum="0" Maximum="100"
                                     Width="30" Foreground="#4CA6FF" Background="{DynamicResource GaugeTrackBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     VerticalAlignment="Stretch"/>
                        <TextBlock x:Name="ClutchValue" Text="0" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"/>
                    </Grid>
                    <Grid x:Name="BrakeGauge" Grid.Column="1" Width="36">
                        <ProgressBar x:Name="BrakeBar" Orientation="Vertical" Minimum="0" Maximum="100"
                                     Width="30" Foreground="#FF4B55" Background="{DynamicResource GaugeTrackBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     VerticalAlignment="Stretch"/>
                        <TextBlock x:Name="BrakeValue" Text="0" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"/>
                    </Grid>
                    <Grid x:Name="ThrottleGauge" Grid.Column="2" Width="36">
                        <ProgressBar x:Name="ThrottleBar" Orientation="Vertical" Minimum="0" Maximum="100"
                                     Width="30" Foreground="#2ED06E" Background="{DynamicResource GaugeTrackBrush}"
                                     BorderBrush="{DynamicResource ControlBorderBrush}"
                                     VerticalAlignment="Stretch"/>
                        <TextBlock x:Name="ThrottleValue" Text="0" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1"/>
                    </Grid>
                </Grid>

                <Border Grid.Column="2" Margin="8,0,0,0" Background="Transparent"
                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="5">
                    <TextBlock x:Name="GearText" Text="N" FontSize="70" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="78"/>
                </Border>

            </Grid>

            <Border x:Name="ControlBar" Grid.Row="0" Panel.ZIndex="10" Style="{StaticResource ControlBarStyle}"
                    Background="{DynamicResource OverlayBackgroundBrush}" CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="ControlButtons" Orientation="Horizontal">
                        <Button Style="{StaticResource ControlBarButtonStyle}"
                                Content="✕" FontSize="13" ToolTip="Close" Click="CloseButton_Click"/>
                        <Button Style="{StaticResource ControlBarButtonStyle}"
                                ToolTip="Settings" Click="SettingsButton_Click">
                            <Viewbox Width="18" Height="18">
                                <Path Width="24" Height="24" Fill="{DynamicResource PrimaryTextBrush}">
                                    <Path.Data>
                                        <GeometryGroup FillRule="EvenOdd">
                                            <PathGeometry Figures="M9,5 L10,5 L10,2 L14,2 L14,5 L15,5 L17,3 L21,7 L19,9 L19,10 L22,10 L22,14 L19,14 L19,15 L21,17 L17,21 L15,19 L14,19 L14,22 L10,22 L10,19 L9,19 L7,21 L3,17 L5,15 L5,14 L2,14 L2,10 L5,10 L5,9 L3,7 L7,3 Z"/>
                                            <EllipseGeometry Center="12,12" RadiusX="3.5" RadiusY="3.5"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Viewbox>
                        </Button>
                        <ToggleButton x:Name="PositionLockButton" Style="{StaticResource PositionLockButtonStyle}"
                                      Click="PositionLockButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Waiting for session..."
                               FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="12,0,8,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="SettingsPanel" Grid.Row="1" Background="{DynamicResource SettingsBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,10,10"
                    Padding="18,12,18,15" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SHOW INPUTS" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                        <CheckBox x:Name="ThrottleCheck" Content="Throttle" IsChecked="True" Checked="InputSelectionChanged" Unchecked="InputSelectionChanged"/>
                        <CheckBox x:Name="BrakeCheck" Content="Brake" IsChecked="True" Checked="InputSelectionChanged" Unchecked="InputSelectionChanged"/>
                        <CheckBox x:Name="ClutchCheck" Content="Clutch" IsChecked="True" Checked="InputSelectionChanged" Unchecked="InputSelectionChanged"/>
                        <TextBlock Text="DISPLAY" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,0"/>
                        <CheckBox x:Name="AlwaysShowTelemetryCheck"
                                  Content="Always show telemetry graph"
                                  ToolTip="When unchecked, show only the status and control bar outside a live session."
                                  Checked="AlwaysShowTelemetryCheck_Changed"
                                  Unchecked="AlwaysShowTelemetryCheck_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="GRAPH TIME SPAN" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="TimeSpanValue" Text="10 seconds" FontSize="15" Margin="0,7,0,2"/>
                        <Slider x:Name="TimeSpanSlider" Minimum="5" Maximum="30" Value="10" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="TimeSpanSlider_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="25,0,0,0">
                        <StackPanel>
                            <TextBlock Text="WINDOW SCALE" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="−" Width="28" FontSize="16" FontWeight="SemiBold"
                                        ToolTip="Decrease scale" Click="ScaleDownButton_Click"/>
                                <TextBlock x:Name="ScaleValueText" Text="100%" Width="54"
                                           FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Button Content="+" Width="28" FontSize="16" FontWeight="SemiBold"
                                        ToolTip="Increase scale" Click="ScaleUpButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="15,0,0,0">
                            <TextBlock Text="THEME" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <StackPanel Margin="0,5,0,0">
                                <RadioButton x:Name="DarkThemeRadio" Content="Dark" GroupName="Theme"
                                             IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}"
                                             Margin="0,2" Checked="ThemeRadio_Checked"/>
                                <RadioButton x:Name="LightThemeRadio" Content="Light" GroupName="Theme"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             Margin="0,2" Checked="ThemeRadio_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
